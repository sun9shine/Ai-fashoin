generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("user")
  plan          String    @default("free")
  dailyTrials   Int       @default(0)
  lastTrialDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  tryOnHistory  TryOnHistory[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  nameAr      String?
  category    String
  price       Float
  currency    String   @default("USD")
  image       String?
  description String?
  storeId     String?
  affiliateUrl String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store       Store?   @relation(fields: [storeId], references: [id])
  tryOnHistory TryOnHistory[]
}

model Store {
  id          String   @id @default(cuid())
  name        String
  url         String?
  logo        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  products    Product[]
}

model Order {
  id            String   @id @default(cuid())
  userId        String
  productId     String?
  amount        Float
  currency      String   @default("USD")
  status        String   @default("pending")
  stripeId      String?
  type          String   @default("subscription")
  plan          String?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])
}

model TryOnHistory {
  id          String   @id @default(cuid())
  userId      String
  productId   String?
  category    String
  inputImage  String
  resultImage String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  product     Product? @relation(fields: [productId], references: [id])
}

model AppSettings {
  id              String  @id @default("settings")
  clothesEnabled  Boolean @default(true)
  makeupEnabled   Boolean @default(true)
  hairEnabled     Boolean @default(true)
  shoesEnabled    Boolean @default(true)
  adsEnabled      Boolean @default(true)
  adRemovalPrice  Float   @default(4.99)
  freeTrialsPerDay Int    @default(5)
}
